rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kiểm tra quyền Quản trị viên duy nhất theo UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == "np7u77LPOxel3f1A4CLDn70WSX22";
    }

    // Kiểm tra tài khoản có đang nằm trong danh sách bị Ban hay không
    function isBanned(uid) {
      return exists(/databases/$(database)/documents/banned/$(uid));
    }

    match /leaderboard/{userId} {
      // Mọi người đều xem được BXH
      allow read: if true;

      // Chỉ Admin mới được xóa trực tiếp một người khỏi BXH
      allow delete: if isAdmin();

      function isValidDoc(data) {
        return data.keys().hasAll(['name', 'rp', 'correctCount', 'studyMinutes', 'tier'])
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 40
          && data.tier is string
          && data.tier.size() <= 40
          && data.rp is int
          && data.rp >= 0
          && data.rp <= 30000
          && data.correctCount is int
          && data.correctCount >= 0
          && data.correctCount <= 3000
          && data.studyMinutes is int
          && data.studyMinutes >= 0
          && data.studyMinutes <= 10000
          && data.rp <= (data.correctCount * 13 + data.studyMinutes * 2)
          && (!('appProgressJson' in data) || (data.appProgressJson is string && data.appProgressJson.size() <= 350000));
      }

      // Chặn Admin ghi điểm lên BXH và chặn tài khoản đã bị Ban
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !isAdmin()
        && !isBanned(userId)
        && isValidDoc(request.resource.data)
        && request.resource.data.rp <= 1500
        && request.resource.data.correctCount <= 120
        && request.resource.data.studyMinutes <= 180;

      // Admin được phép reset điểm bất kỳ ai; người chơi thường phải tuân thủ quy tắc chống gian lận
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && !isAdmin()
        && !isBanned(userId)
        && isValidDoc(request.resource.data)
        && request.resource.data.correctCount >= resource.data.correctCount
        && request.resource.data.studyMinutes >= resource.data.studyMinutes
        && request.resource.data.rp >= resource.data.rp
        && (request.resource.data.rp - resource.data.rp) <= (
             (request.resource.data.correctCount - resource.data.correctCount) * 13
             + (request.resource.data.studyMinutes - resource.data.studyMinutes) * 2
           )
        && (request.resource.data.correctCount - resource.data.correctCount) <= 45
        && (request.resource.data.rp - resource.data.rp) <= 600
        && (
             !('updatedAt' in resource.data)
             || !(resource.data.updatedAt is timestamp)
             || (request.resource.data.correctCount - resource.data.correctCount) <= 3
             || (request.time.toMillis() - resource.data.updatedAt.toMillis())
                >= (request.resource.data.correctCount - resource.data.correctCount) * 2000
           )
      );
    }

    // Danh sách tài khoản bị Admin khóa khỏi BXH
    match /banned/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Phản hồi báo lỗi câu hỏi / đáp án từ người học (chỉ Admin được đọc và xóa)
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasAll([
          'qid', 'ch', 'n', 'questionText', 'currentAnswer', 'reason', 'note', 'reporterUid', 'reporterName', 'appVersion'
        ])
        && request.resource.data.qid is string
        && request.resource.data.qid.size() >= 1
        && request.resource.data.qid.size() <= 40
        && request.resource.data.ch is int
        && request.resource.data.ch >= 0
        && request.resource.data.ch <= 10
        && request.resource.data.n is int
        && request.resource.data.n >= 0
        && request.resource.data.n <= 1000
        && request.resource.data.questionText is string
        && request.resource.data.questionText.size() >= 1
        && request.resource.data.questionText.size() <= 600
        && request.resource.data.currentAnswer is string
        && request.resource.data.currentAnswer.size() <= 240
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 350
        && request.resource.data.reporterUid is string
        && request.resource.data.reporterUid.size() <= 128
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() <= 40
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 20;
    }
  }
}
